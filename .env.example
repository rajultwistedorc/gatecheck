# GateCheck configuration. Copy to .env and fill in. NEVER commit .env.

# --- Mode --------------------------------------------------------------------
# false = real Credence ID Cloud SDK. The server refuses to start if a required value is missing.
# true  = fake Cloud SDK adapter. No credentials, network or wallet needed.
MOCK_MODE=false

# --- Credence ID Cloud SDK (required when MOCK_MODE=false) --------------------
CREDENCE_BASE_URL=https://credenceid.com/cloudsdk/playground
# License key from the Verify with Credence portal. Secret. Only the server reads it.
CREDENCE_LICENSE_KEY=
# Reader profile used by the age-restricted gates (UUID). Required in live mode.
CREDENCE_PROFILE_AGE_CHECK=
# Optional second profile that returns name / portrait. When empty, gates that ask for it
# fall back as described in config/gates.json (general entry becomes "age check only").
CREDENCE_PROFILE_ID_CHECK=
# The exact https origin registered with Credence, e.g. https://gate.example.com
# (scheme + host, no path, no trailing slash). Sent as the Origin header on Cloud SDK calls
# and used to build the QR and wallet return URLs.
REGISTERED_ORIGIN=

# --- Server ------------------------------------------------------------------
PORT=8787
# Number of reverse-proxy hops to trust for client IPs (rate limiting). 0 = none.
TRUST_PROXY=0
# Shared passcode for the staff screens (/gate/*, /admin) and the debug endpoint.
# Set this on any host reachable from the internet. In live mode the debug endpoint
# stays disabled until it is set.
STAFF_PASSCODE=

# --- Gate behaviour ----------------------------------------------------------
# How long a QR code / attempt stays valid.
SESSION_TTL_SECONDS=120
# How long a result stays on the staff screen before the next QR is shown.
RESULT_DISPLAY_SECONDS=12
# IANA timezone used to decide "today" when age is computed from birth_date,
# e.g. America/New_York. Empty = UTC.
VENUE_TIMEZONE=

# --- Entry log ---------------------------------------------------------------
DB_PATH=./data/gatecheck.sqlite
# Rows older than this are deleted by the purge job.
LOG_RETENTION_DAYS=30
PURGE_INTERVAL_MINUTES=60

# --- Digital Credentials API details where the docs and the official sample differ ----
# Flow A `data`: "deviceRequest" (integration guide) or "dcRequest" (whole object, as the sample app does).
DC_MDOC_REQUEST_SHAPE=deviceRequest
# Flow B protocol: "openid4vp" (integration guide) or "openid4vp-v1-unsigned" (as the sample app does).
DC_OPENID4VP_PROTOCOL=openid4vp

# --- Config files ------------------------------------------------------------
GATES_CONFIG_PATH=./config/gates.json
TICKETS_CONFIG_PATH=./config/tickets.json
